<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.store.mapper.StoreOrderItemMapper">

    <resultMap type="com.ruoyi.store.domain.StoreOrderItem" id="StoreOrderItemResult">
        <result property="itemId"    column="item_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="productId"    column="product_id"    />
        <result property="productName"    column="product_name"    />
        <result property="specification"    column="specification"    />
        <result property="unit"    column="unit"    />
        <result property="salePrice"    column="sale_price"    />
        <result property="quantity"    column="quantity"    />
        <result property="subtotal"    column="subtotal"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectStoreOrderItemVo">
        select item_id, order_id, product_id, product_name, specification, unit, sale_price, quantity, subtotal, create_time from store_order_item
    </sql>

    <select id="selectStoreOrderItemByOrderId" parameterType="Long" resultMap="StoreOrderItemResult">
        <include refid="selectStoreOrderItemVo"/>
        where order_id = #{orderId}
        order by item_id asc
    </select>

    <insert id="insertStoreOrderItem" parameterType="com.ruoyi.store.domain.StoreOrderItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into store_order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="specification != null">specification,</if>
            <if test="unit != null">unit,</if>
            <if test="salePrice != null">sale_price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="subtotal != null">subtotal,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="specification != null">#{specification},</if>
            <if test="unit != null">#{unit},</if>
            <if test="salePrice != null">#{salePrice},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="subtotal != null">#{subtotal},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <insert id="batchStoreOrderItem">
        insert into store_order_item (order_id, product_id, product_name, specification, unit, sale_price, quantity, subtotal, create_time) values
        <foreach item="item" collection="list" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.productName}, #{item.specification}, #{item.unit},
             #{item.salePrice}, #{item.quantity}, #{item.subtotal}, #{item.createTime})
        </foreach>
    </insert>

    <delete id="deleteStoreOrderItemByOrderId" parameterType="Long">
        delete from store_order_item where order_id = #{orderId}
    </delete>
</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.store.mapper.StoreMemberLevelMapper">

    <resultMap type="com.ruoyi.store.domain.StoreMemberLevel" id="StoreMemberLevelResult">
        <result property="levelId"    column="level_id"    />
        <result property="levelName"    column="level_name"    />
        <result property="minPoints"    column="min_points"    />
        <result property="discount"    column="discount"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectStoreMemberLevelVo">
        select level_id, level_name, min_points, discount, status, create_by, create_time, update_by, update_time, remark from store_member_level
    </sql>

    <select id="selectStoreMemberLevelList" parameterType="com.ruoyi.store.domain.StoreMemberLevel" resultMap="StoreMemberLevelResult">
        <include refid="selectStoreMemberLevelVo"/>
        <where>
            <if test="levelName != null  and levelName != ''"> and level_name like concat('%', #{levelName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by min_points asc
    </select>

    <select id="selectStoreMemberLevelByLevelId" parameterType="Long" resultMap="StoreMemberLevelResult">
        <include refid="selectStoreMemberLevelVo"/>
        where level_id = #{levelId}
    </select>

    <insert id="insertStoreMemberLevel" parameterType="com.ruoyi.store.domain.StoreMemberLevel" useGeneratedKeys="true" keyProperty="levelId">
        insert into store_member_level
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="levelName != null and levelName != ''">level_name,</if>
            <if test="minPoints != null">min_points,</if>
            <if test="discount != null">discount,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="levelName != null and levelName != ''">#{levelName},</if>
            <if test="minPoints != null">#{minPoints},</if>
            <if test="discount != null">#{discount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateStoreMemberLevel" parameterType="com.ruoyi.store.domain.StoreMemberLevel">
        update store_member_level
        <trim prefix="SET" suffixOverrides=",">
            <if test="levelName != null and levelName != ''">level_name = #{levelName},</if>
            <if test="minPoints != null">min_points = #{minPoints},</if>
            <if test="discount != null">discount = #{discount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where level_id = #{levelId}
    </update>

    <delete id="deleteStoreMemberLevelByLevelId" parameterType="Long">
        delete from store_member_level where level_id = #{levelId}
    </delete>

    <delete id="deleteStoreMemberLevelByLevelIds" parameterType="String">
        delete from store_member_level where level_id in
        <foreach item="levelId" collection="array" open="(" separator="," close=")">
            #{levelId}
        </foreach>
    </delete>
</mapper>
